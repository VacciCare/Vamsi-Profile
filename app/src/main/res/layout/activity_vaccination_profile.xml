<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="@string/cd_back_navigation"
                app:tint="#1A2530" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@id/btnBack"
                android:layout_marginStart="8dp"
                android:text="@string/title_vaccination_profile"
                android:textColor="#1A2530"
                android:textSize="20sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp" >

                <ImageView
                    android:id="@+id/ivProfileAvatar"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:src="@drawable/ic_child_avatar"
                    android:contentDescription="@string/cd_child_avatar" />

                <TextView
                    android:id="@+id/tvProfileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/profile_name"
                    android:textColor="#1A2530"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnParentGuardian"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="12dp"
            app:backgroundTint="#FFFFFF"
            android:text="@string/menu_parent_details"
            android:textColor="#1A2530"
            android:textSize="15sp"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            app:strokeColor="#E2E8F0"
            app:strokeWidth="1dp"
            app:cornerRadius="12dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVaccinationRecords"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="12dp"
            app:backgroundTint="#FFFFFF"
            android:text="@string/menu_vaccination_records"
            android:textColor="#1A2530"
            android:textSize="15sp"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            app:strokeColor="#E2E8F0"
            app:strokeWidth="1dp"
            app:cornerRadius="12dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAppointmentHistory"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="12dp"
            app:backgroundTint="#FFFFFF"
            android:text="@string/menu_appointment_history"
            android:textColor="#1A2530"
            android:textSize="15sp"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            app:strokeColor="#E2E8F0"
            app:strokeWidth="1dp"
            app:cornerRadius="12dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMedicalSafetyInfo"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="12dp"
            app:backgroundTint="#FFFFFF"
            android:text="@string/menu_medical_safety_info"
            android:textColor="#1A2530"
            android:textSize="15sp"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            app:strokeColor="#E2E8F0"
            app:strokeWidth="1dp"
            app:cornerRadius="12dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnChangePassword"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="12dp"
            app:backgroundTint="#FFFFFF"
            android:text="@string/menu_change_password"
            android:textColor="#1A2530"
            android:textSize="15sp"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            app:strokeColor="#E2E8F0"
            app:strokeWidth="1dp"
            app:cornerRadius="12dp"/>

            <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHelpSupport"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="24dp"
            app:backgroundTint="#FFFFFF"
            android:text="@string/menu_help_support"
            android:textColor="#1A2530"
            android:textSize="15sp"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            app:strokeColor="#E2E8F0"
            app:strokeWidth="1dp"
            app:cornerRadius="12dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:text="🛑  Logout"
            android:textColor="#DC3545"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>